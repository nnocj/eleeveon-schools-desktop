{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/owner/layout,_N_T_/owner/subscriptions/layout,_N_T_/owner/subscriptions/page,_N_T_/owner/subscriptions"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/owner/subscriptions/__PAGE__",
    "/owner/subscriptions",
    "/owner",
    "/_index",
    "/_head"
  ]
}