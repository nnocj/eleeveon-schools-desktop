      "page": "/verify/[token]",
      "regex": "^/verify/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/verify/(?<nxtPtoken>[^/]+?)(?:/)?$"
    }
  ],
